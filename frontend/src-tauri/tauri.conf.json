{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mix-agent",
  "version": "0.2.0",
  "identifier": "com.quintarabio.mix-agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "mix-agent",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:5173 ws://localhost:5173; connect-src 'self' http://localhost:8000 http://localhost:5173 ws://localhost:5173 https://api.minimax.chat https://api.deepseek.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
