{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mix-agent default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$CWD/**" },
        { "path": "$APPDATA/**" }
      ]
    }
  ]
}
